# Copy to .env (optional). Everything here can also be set from Settings in the app.
PORT=8787
HOST=0.0.0.0
# Where all data (db, uploads, artifacts, config) is stored
DATA_DIR=./data
# Optional: preset API key (otherwise set it in Settings → Model)
ANTHROPIC_API_KEY=
# Set to 1 when the app is served over HTTPS (behind Caddy/Nginx/Cloudflare) so cookies are Secure
SECURE_COOKIES=0
